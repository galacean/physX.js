SET(EMSCRIPTEN_USE_ASSERTIONS "0")
SET(EMSCRIPTEN_BASE_OPTIONS "--bind -flto -s MODULARIZE=1 -s EXPORT_NAME=PHYSX -s ALLOW_MEMORY_GROWTH=1 -s NO_DYNAMIC_EXECUTION=1 -s EXPORTED_FUNCTIONS=[_malloc,_free] -s EXPORTED_RUNTIME_METHODS=[HEAPF32,HEAPU16,HEAPU32]")

IF(NOT DEFINED ENV{PX_ENABLE_SIMD})
	# iOS 14 WebKit cannot compile WebAssembly bulk-memory instructions
	# Prevent post-link optimization from reintroducing them in the non-SIMD fallback
	SET(EMSCRIPTEN_BASE_OPTIONS "${EMSCRIPTEN_BASE_OPTIONS} -mno-bulk-memory-opt -mno-bulk-memory")
ENDIF()


SET(LL_SOURCE_DIR ${PHYSX_SOURCE_DIR}/physxwebbindings/src)

SET(PXPHYSX_LIBTYPE_DEFS 
	PX_PHYSX_STATIC_LIB;
)	

SET(PHYSX_WEB_BINDINGS_COMPILE_DEFS
	# Common to all configurations
	${PHYSX_EMSCRIPTEN_COMPILE_DEFS};${PXPHYSX_LIBTYPE_DEFS};${PHYSX_GPU_SHARED_LIB_NAME_DEF};${PXPHYSX_GPU_DEFS}

	$<$<CONFIG:debug>:${PHYSX_EMSCRIPTEN_DEBUG_COMPILE_DEFS};>
	$<$<CONFIG:checked>:${PHYSX_EMSCRIPTEN_CHECKED_COMPILE_DEFS};>
	$<$<CONFIG:profile>:${PHYSX_EMSCRIPTEN_PROFILE_COMPILE_DEFS};>
	$<$<CONFIG:release>:${PHYSX_EMSCRIPTEN_RELEASE_COMPILE_DEFS};>
)

SET(CMAKE_STATIC_LIBRARY_SUFFIX ".a")

SET(PHYSX_WEB_BINDINGS_SOURCE
		${LL_SOURCE_DIR}/PxWebBindings.cpp
		${LL_SOURCE_DIR}/SimulationFilterShader.cpp
)
SOURCE_GROUP(src FILES ${PHYSX_WEB_BINDINGS_SOURCE})

ADD_LIBRARY(PhysXWebBindingsObjects OBJECT ${PHYSX_WEB_BINDINGS_SOURCE})
TARGET_COMPILE_DEFINITIONS(PhysXWebBindingsObjects PRIVATE ${PHYSX_WEB_BINDINGS_COMPILE_DEFS})

TARGET_INCLUDE_DIRECTORIES(PhysXWebBindingsObjects
	PRIVATE ${PHYSX_ROOT_DIR}/include
	PRIVATE $<TARGET_PROPERTY:PhysXFoundation,INTERFACE_INCLUDE_DIRECTORIES>
	PRIVATE ${PHYSX_SOURCE_DIR}/common/include
	PRIVATE $<TARGET_PROPERTY:PhysXCommon,INTERFACE_INCLUDE_DIRECTORIES>
)

ADD_DEFINITIONS(-DNDEBUG)
SET(PHYSX_WEB_LINK_FLAGS "${EMSCRIPTEN_BASE_OPTIONS} -s ASSERTIONS=${EMSCRIPTEN_USE_ASSERTIONS}")
FOREACH(target PhysXWebBindings PhysXWebBindingsModule)
	ADD_EXECUTABLE(${target} $<TARGET_OBJECTS:PhysXWebBindingsObjects>)
	TARGET_LINK_LIBRARIES(${target}
		PUBLIC PhysX PhysXCharacterKinematic PhysXCommon PhysXCooking PhysXExtensions PhysXFoundation PhysXVehicle
	)
	SET_TARGET_PROPERTIES(${target} PROPERTIES
		OUTPUT_NAME "physx.${CMAKE_BUILD_TYPE}"
		LINK_FLAGS "${PHYSX_WEB_LINK_FLAGS}"
	)
ENDFOREACH()

# Keep the temporary ESM link in a separate directory so both loaders use the same WASM basename.
STRING(TOUPPER "${CMAKE_BUILD_TYPE}" PHYSX_WEB_CONFIG)
SET_TARGET_PROPERTIES(PhysXWebBindingsModule PROPERTIES
	SUFFIX ".mjs"
	LINK_FLAGS "${PHYSX_WEB_LINK_FLAGS} -s EXPORT_ES6=1"
	RUNTIME_OUTPUT_DIRECTORY_${PHYSX_WEB_CONFIG} "${CMAKE_RUNTIME_OUTPUT_DIRECTORY_${PHYSX_WEB_CONFIG}}/module"
)
